# Copiar este archivo como ".env" en la raíz del proyecto:  cp .env.template .env
# El .env NO se sube a GitHub (está en .gitignore); este template sí, sin datos reales.
# Los valores por defecto coinciden con docker-compose.postgres.yml

# Conexión a PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prisma"

# Puerto del backend (el frontend espera 3000, ver src/environments)
PORT=3000

# Clave para firmar los tokens JWT. En desarrollo puede ser cualquier texto largo.
JWT_SECRET="cambiar-por-un-texto-largo-y-secreto"

# Frontends que pueden llamar a la API (CORS), separados por coma.
# Opcional: si no está, se permite solo http://localhost:4200 (ng serve).
CORS_ORIGINS="http://localhost:4200"
