# Copiar este archivo como ".env" en la raíz del proyecto:  cp .env.example .env
# Los valores por defecto coinciden con docker-compose.postgres.yml

# Conexión a PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prisma"

# Puerto del backend (el frontend espera 3000, ver src/environments)
PORT=3000

# Clave para firmar los tokens JWT. En desarrollo puede ser cualquier texto largo.
JWT_SECRET="cambiar-por-un-texto-largo-y-secreto"
