generator client {
  
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
}

model Login {
    id              Int     @id @default(autoincrement())
    email           String  @unique
    password        String
    id_rol          Int
    rol             Rol     @relation(fields: [id_rol], references: [id])
    usuario         Usuario?
}

model Usuario {
    id              Int     @id @default(autoincrement())
    email           String  @unique
    nombre          String
    apellido        String
    direccion       String
    login           Login   @relation(fields: [email], references: [email])
    pedidos         Pedido[]
}

model Rol {
    id              Int     @id @default(autoincrement())
    nombre          String  @unique
    login           Login[]
}

model Categoria {
    id              Int     @id @default(autoincrement())
    nombre          String  @unique
    imagen          String
    subcategorias   Subcategoria[]
    Producto        Producto[]
}

model Subcategoria {
    id              Int     @id @default(autoincrement())
    id_categoria    Int     
    nombre          String  
    Producto        Producto[]
    categoria       Categoria @relation(fields: [id_categoria], references: [id])
}

model Producto {
    id              Int     @id @default(autoincrement())
    id_categoria    Int     
    id_subcategoria Int     
    nombre          String
    stock           Int
    precio          Decimal
    categoria       Categoria @relation(fields: [id_categoria], references: [id], map:"deProductoACategoria")
    subcategoria    Subcategoria @relation(fields: [id_subcategoria], references: [id])
    estilo          Producto_estilo[]
    detalle         Producto_detalles[]
    imagen           String?
    destacado     Boolean      @default(false)
}

model Producto_estilo {
    id              Int     @id @default(autoincrement())
    id_producto     Int 
    producto        Producto @relation(fields: [id_producto], references: [id])
    nombre          String
    descripcion     String
}

model Producto_detalles {
    id              Int     @id @default(autoincrement())
    id_producto     Int 
    producto        Producto @relation(fields: [id_producto], references: [id])
    nombre          String
    descripcion     String
}

model Pedido {
    id              Int     @id @default(autoincrement())
    id_usuario      Int
    fecha           DateTime @default(now())
    estado          String   @default("carrito")
    usuario         Usuario  @relation(fields: [id_usuario], references: [id])
    productos       Pedido_productos[]
}

// Guarda una COPIA de nombre/categoría/precio al momento de la compra,
// así el pedido no cambia si después se edita o borra el producto.
model Pedido_productos {
    id              Int     @id @default(autoincrement())
    id_pedido       Int
    producto        String
    categoria       String
    subcategoria    String
    precio          Decimal
    cantidad        Int     @default(1)
    pedido          Pedido @relation(fields: [id_pedido], references: [id])
}